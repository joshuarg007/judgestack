# Sanity project
SANITY_PROJECT_ID=g2mmasfd
SANITY_DATASET=production
# Write token (Editor) for ingest scripts only. Never ship to the browser.
SANITY_WRITE_TOKEN=

# Sanity Context (organization-level)
SANITY_ORGANIZATION_ID=
# Organization API token, Context Viewer permission
SANITY_ORGANIZATION_TOKEN=

# Two endpoints. Keep them separate: a dataset source on an endpoint
# causes its Knowledge Base sources to be ignored entirely.
SANITY_CONTEXT_GROQ_URL=
SANITY_CONTEXT_KB_URL=
SANITY_KNOWLEDGE_BASE_ID=

# Model
ANTHROPIC_API_KEY=
JUDGESTACK_PROVIDER=ollama
JUDGESTACK_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# DeepSeek: ~$0.15/M input, $0.60/M output off-peak. Native tool calls and JSON.
# Set JUDGESTACK_PROVIDER=deepseek to use it.
DEEPSEEK_API_KEY=
